{
  "name": "@audiotse/gate",
  "version": "0.1.0",
  "description": "AudioTSE 声纹门控 SDK：主入口 = VAD+门控完整版；'@audiotse/gate/core' = 无 VAD 声纹过滤核心（外部已有 VAD 的场景，如内网）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "main": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "main": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:formats": "node script/build-formats.js",
    "validate": "tsx test/full/validate-embedding.ts",
    "test": "tsx test/full/gate-e2e.ts",
    "test:core": "tsx test/core/filter-e2e.ts"
  },
  "engines": {
    "node": ">=18.20"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.12.1",
    "sherpa-onnx-win-x64": "1.12.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2"
  }
}
